# This is an example only. Do not put real values in this file or commit a .env file.
# During the test migration, copy the names into the host control panel's environment section.

NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=GENERATE_A_NEW_LONG_RANDOM_VALUE
VITE_AUTH_MODE=external

# Keeps all existing /manus-storage/{key} paths working after media is copied to a new bucket.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://S3-COMPATIBLE-ENDPOINT
S3_REGION=auto
S3_BUCKET=ishraqa-media
S3_ACCESS_KEY_ID=YOUR_EXTERNAL_STORAGE_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_EXTERNAL_STORAGE_SECRET
S3_FORCE_PATH_STYLE=true

# Deliberately leave the platform-only OAuth and Forge variables unset for the external test.
# VITE_AUTH_MODE=external stops the public frontend from redirecting to platform-only OAuth.
# Add independent AI, email and authentication variables only after selecting their providers.
